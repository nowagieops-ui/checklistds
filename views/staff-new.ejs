<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <title>Add Staff — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body class="app-bg">

  <div class="mgr-header">
    <div class="mgr-header-inner">
      <div class="app-header-badge">D</div>
      <div class="mgr-header-brand">Dashspid Ops</div>
      <span class="badge badge-orange" style="background:rgba(255,92,0,0.2);color:#ffb37a;">Manager</span>
      <div class="app-header-spacer"></div>
      <a href="/management-logout" class="btn btn-outline" style="width:auto;padding:8px 16px;font-size:13px;margin:0;color:rgba(255,255,255,0.7);border-color:rgba(255,255,255,0.2);">Log out</a>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <div class="card-title">Add Staff</div>
      <div class="card-sub">Adds a new staff member who can log into the app.</div>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/management/staff" id="staffForm">
        <label for="name">Full name <span style="color:var(--red)">*</span></label>
        <input type="text" name="name" id="name" placeholder="e.g. Musa Abdullahi" required>

        <label for="pin">4-digit PIN <span style="color:var(--red)">*</span></label>
        <input type="text" name="pin" id="pin" placeholder="e.g. 4821" inputmode="numeric" pattern="\d{4}" maxlength="4" required>

        <label for="role">Role <span style="color:var(--red)">*</span></label>
        <select name="role" id="role" required>
          <option value="field_marketer" <%= (role || 'field_marketer') === 'field_marketer' ? 'selected' : '' %>>Field Marketer</option>
          <option value="telemarketer" <%= role === 'telemarketer' ? 'selected' : '' %>>Telemarketer</option>
        </select>
        <div class="note-box" style="margin-bottom:20px;">
          <div class="note-box-body">Telemarketers must complete the training academy the first time they log in, before they can reach anything else.</div>
        </div>

        <div id="companyBox" style="display:none;">
          <label class="check-item">
            <input type="checkbox" name="works_nowagieops" value="1">
            <span class="check-item-text">Also works NowagieOps cold calls (in addition to DashSpid) — she'll pick which one at login and complete both training academies separately.</span>
          </label>
        </div>

        <button type="submit" class="btn" id="submitBtn">Add Staff →</button>
      </form>
    </div>

    <a href="/dashboard" class="logout-link">← Back to Dashboard</a>
  </div>

  <div class="loader-overlay" id="loaderOverlay">
    <div>
      <div class="loader-spinner"></div>
      <div class="loader-text">Adding staff member...</div>
    </div>
  </div>

  <script>
    var roleSelect = document.getElementById('role');
    var companyBox = document.getElementById('companyBox');
    function toggleCompanyBox() {
      companyBox.style.display = roleSelect.value === 'telemarketer' ? 'block' : 'none';
    }
    roleSelect.addEventListener('change', toggleCompanyBox);
    toggleCompanyBox();

    document.getElementById('staffForm').addEventListener('submit', function() {
      document.getElementById('submitBtn').disabled = true;
      document.getElementById('submitBtn').textContent = 'Please wait...';
      document.getElementById('loaderOverlay').classList.add('active');
    });
  </script>
</body>
</html>
