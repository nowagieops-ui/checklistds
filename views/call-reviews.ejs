<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Call Reviews — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=<%= assetVersion %>">
  <link rel="manifest" href="/manifest.json?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body class="app-bg">

  <% if (viewerIsManagement) { %>
    <div class="mgr-header">
      <div class="mgr-header-inner">
        <div class="app-header-badge">D</div>
        <div class="mgr-header-brand">Dashspid Ops</div>
        <span class="badge badge-orange" style="background:rgba(255,92,0,0.2);color:#ffb37a;">Manager</span>
        <div class="app-header-spacer"></div>
        <a href="/management-logout" class="btn btn-outline" style="width:auto;padding:8px 16px;font-size:13px;margin:0;color:rgba(255,255,255,0.7);border-color:rgba(255,255,255,0.2);">Log out</a>
      </div>
    </div>
  <% } else { %>
    <div class="app-header">
      <div class="app-header-inner">
        <a href="/home" class="app-header-brand">
          <div class="app-header-badge">D</div>
          Dashspid Ops
        </a>
      </div>
    </div>
  <% } %>

  <div class="container">
    <div class="card">
      <div class="card-title">Call Reviews</div>
      <% if (viewerIsManagement) { %>
        <div class="card-sub" style="margin-bottom:0;">Every telemarketer's uploaded calls, AI-transcribed and graded — newest first.</div>
      <% } else { %>
        <div class="card-sub" style="margin-bottom:0;">Upload your recorded calls — AI transcribes and grades each one, so you know exactly where you did well and where to improve.</div>
      <% } %>
    </div>

    <% if (!aiConfigured) { %>
      <div class="note-box">
        <div class="note-box-body">AI review isn't switched on yet for this app — <%= viewerIsManagement ? 'uploads' : 'your uploads' %> will sit as "Pending" until it is. Nothing is lost, they'll process automatically once it's configured.</div>
      </div>
    <% } %>

    <% if (!viewerIsManagement) { %>
      <div class="card">
        <form method="POST" action="/call-reviews" enctype="multipart/form-data" id="uploadForm">
          <label for="calls">Upload one or many call recordings</label>
          <input type="file" name="calls" id="calls" accept="audio/*" multiple required>
          <div style="font-size:12px;color:var(--gray);margin:6px 0 14px;">Up to 100 at once, 15MB each. You can upload as many as you called today — each is reviewed on its own.</div>
          <button type="submit" class="btn" id="uploadBtn">Upload →</button>
        </form>
      </div>
    <% } %>

    <div class="section-title"><%= viewerIsManagement ? 'All Uploads' : 'Your Uploads' %></div>
    <% if (reviews.length === 0) { %>
      <div class="card" style="text-align:center;color:var(--gray);font-size:14px;">Nothing uploaded yet.</div>
    <% } else { %>
      <% reviews.forEach(function (r) { %>
        <div class="card">
          <div style="display:flex;justify-content:space-between;align-items:flex-start;gap:10px;flex-wrap:wrap;">
            <div>
              <div style="font-weight:700;font-size:14px;"><%= r.original_filename %></div>
              <div style="font-size:12px;color:var(--gray);">
                <% if (viewerIsManagement) { %><%= r.staff_name %> · <% } %><%= r.uploadedFormatted %> · <%= r.company === 'nowagieops' ? 'NowagieOps' : 'DashSpid' %>
              </div>
            </div>
            <div style="text-align:right;">
              <% if (r.status === 'pending') { %>
                <span class="badge badge-amber">Pending</span>
              <% } else if (r.status === 'processing') { %>
                <span class="badge badge-amber">Reviewing…</span>
              <% } else if (r.status === 'error') { %>
                <span class="badge badge-red">Couldn't review</span>
              <% } else if (r.grade !== null) { %>
                <span class="badge <%= r.grade >= 8 ? 'badge-green' : r.grade >= 5 ? 'badge-amber' : 'badge-red' %>"><%= r.grade %>/10</span>
              <% } %>
            </div>
          </div>

          <% if (r.status === 'error') { %>
            <div style="font-size:13px;color:var(--red);margin-top:8px;"><%= r.error_message %></div>
          <% } else if (r.status === 'done') { %>
            <div style="margin-top:10px;font-size:13px;"><%= r.summary %></div>
            <div class="detail-row" style="margin-top:8px;">
              <span class="detail-label">What went well</span>
              <span class="detail-value"><%= r.did_well %></span>
            </div>
            <div class="detail-row">
              <span class="detail-label">Where to improve</span>
              <span class="detail-value"><%= r.to_improve %></span>
            </div>
            <% if (r.transcript) { %>
              <details style="margin-top:10px;">
                <summary style="cursor:pointer;font-size:13px;color:var(--gray);">View full transcript</summary>
                <div style="white-space:pre-wrap;font-size:13px;margin-top:8px;max-height:300px;overflow-y:auto;padding:10px;background:var(--light-gray, #f5f5f5);border-radius:8px;"><%= r.transcript %></div>
              </details>
            <% } %>
          <% } %>
        </div>
      <% }) %>
    <% } %>

    <% if (viewerIsManagement) { %>
      <a href="/dashboard" class="logout-link">← Back to Dashboard</a>
    <% } else { %>
      <a href="/home" class="logout-link">← Back to Home</a>
    <% } %>
  </div>

  <% if (!viewerIsManagement) { %>
    <script>
      document.getElementById('uploadForm').addEventListener('submit', function () {
        document.getElementById('uploadBtn').disabled = true;
        document.getElementById('uploadBtn').textContent = 'Uploading…';
      });
    </script>
  <% } %>
  <script src="/install-prompt.js?v=<%= assetVersion %>"></script>
</body>
</html>
