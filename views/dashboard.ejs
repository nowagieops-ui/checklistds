<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Field Dashboard — Dashspid</title>
  <link rel="stylesheet" href="/style.css">
  <meta http-equiv="refresh" content="120">
</head>
<body>
  <div class="container wide">

    <div class="dash-header">
      <div>
        <div class="logo-text" style="color:#FF5C00;font-size:26px;">DASHSPID</div>
        <div class="dash-date"><%= today %> · Auto-refreshes every 2 minutes</div>
      </div>
      <a href="/management-logout" class="btn btn-outline" style="width:auto;padding:8px 18px;font-size:14px;">Log out</a>
    </div>

    <!-- TODAY'S STATUS -->
    <div class="section-title">Today's Check-In Status · Cutoff <%= cutoff %></div>
    <div class="status-grid">
      <% status.forEach(s => { %>
        <div class="status-card <%= s.submitted ? (s.isLate ? 'submitted-late' : 'submitted-on-time') : 'not-submitted' %>">
          <div class="status-name"><%= s.name %></div>

          <% if (s.submitted && !s.isLate) { %>
            <span class="status-badge badge-green">✅ On time</span>
          <% } else if (s.submitted && s.isLate) { %>
            <span class="status-badge badge-amber">⚠️ Late — <%= s.checkIn %></span>
          <% } else { %>
            <span class="status-badge badge-red">❌ Not checked in</span>
          <% } %>

          <div class="status-detail">
            <% if (s.submitted) { %>
              <strong>Checked in:</strong> <%= s.checkIn %><br>
              <strong>Zone:</strong> <%= s.zone %><br>
              <strong>Targets:</strong> <%= s.targets %><br>
              <% if (s.notes) { %><strong>Notes:</strong> <%= s.notes %><% } %>
            <% } else { %>
              Has not submitted today's checklist yet.
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- SUMMARY ROW -->
    <%
      const checkedIn = status.filter(s => s.submitted).length;
      const total = status.length;
      const pct = total > 0 ? Math.round((checkedIn / total) * 100) : 0;
    %>
    <div class="card" style="margin-bottom:28px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <div style="font-size:14px;font-weight:700;color:#111827;">Team check-in today</div>
        <div style="font-size:20px;font-weight:800;color:<%= checkedIn === total ? '#059669' : '#DC2626' %>"><%= checkedIn %>/<%= total %></div>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar" style="width:<%= pct %>%"></div>
      </div>
    </div>

    <!-- HISTORY TABLE -->
    <div class="section-title" style="margin-bottom:14px;">Last 7 Days — Submission History</div>
    <% if (history.length > 0) { %>
      <table class="history-table">
        <thead>
          <tr>
            <th>Date</th>
            <th>Marketer</th>
            <th>Check-in</th>
            <th>Status</th>
            <th>Zone</th>
            <th>Targets</th>
          </tr>
        </thead>
        <tbody>
          <% history.forEach(h => { %>
            <%
              const checkTime = new Date(h.submitted_at).toLocaleTimeString('en-GB', {hour:'2-digit',minute:'2-digit'});
              const cutoffTime = '<%= cutoff %>';
              const late = checkTime > '08:45';
            %>
            <tr>
              <td><%= new Date(h.date).toLocaleDateString('en-GB', {weekday:'short', day:'numeric', month:'short'}) %></td>
              <td><strong><%= h.marketer_name %></strong></td>
              <td><%= checkTime %></td>
              <td><span class="<%= late ? 'late' : 'on-time' %>"><%= late ? '⚠️ Late' : '✅ On time' %></span></td>
              <td><%= h.zone || '—' %></td>
              <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= h.targets || '—' %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div style="background:#fff;border-radius:12px;padding:24px;text-align:center;color:#6B7280;font-size:14px;">
        No submissions yet this week.
      </div>
    <% } %>

    <a href="/management-logout" class="logout-link">Log out of management</a>
  </div>
</body>
</html>
