<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#6366f1">
  <title>Field Dashboard — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/style.css">
  <meta http-equiv="refresh" content="120">
</head>
<body class="app-bg">

  <div class="mgr-header">
    <div class="mgr-header-inner">
      <div class="app-header-badge">D</div>
      <div class="mgr-header-brand">Dashspid Ops</div>
      <span class="badge badge-indigo" style="background:rgba(99,102,241,0.2);color:#a5b4fc;">Manager</span>
      <div class="app-header-spacer"></div>
      <a href="/management-logout" class="btn btn-outline" style="width:auto;padding:8px 16px;font-size:13px;margin:0;color:rgba(255,255,255,0.7);border-color:rgba(255,255,255,0.2);">Log out</a>
    </div>
  </div>

  <div class="container wide">

    <div class="dash-header" style="margin-top:1.5rem;">
      <div>
        <div class="dash-title">Today's Check-In Status</div>
        <div class="dash-date"><%= today %> · Cutoff <%= cutoff %> · Auto-refreshes every 2 minutes</div>
      </div>
    </div>

    <div class="status-grid">
      <% status.forEach(s => { %>
        <% var initials = (s.name || '').trim().split(/\s+/).map(w => w[0] || '').join('').slice(0,2).toUpperCase(); %>
        <div class="status-card <%= s.submitted ? (s.isLate ? 'submitted-late' : 'submitted-on-time') : 'not-submitted' %>">
          <div class="status-head">
            <div class="avatar" style="width:40px;height:40px;font-size:14px;background:rgba(99,102,241,0.14);color:var(--indigo);border:1.5px solid rgba(99,102,241,0.3);"><%= initials %></div>
            <div>
              <div class="status-name"><%= s.name %></div>
              <% if (s.submitted && !s.isLate) { %>
                <span class="badge badge-green">✅ On time</span>
              <% } else if (s.submitted && s.isLate) { %>
                <span class="badge badge-amber">⚠️ Late — <%= s.checkIn %></span>
              <% } else { %>
                <span class="badge badge-red">❌ Not checked in</span>
              <% } %>
            </div>
          </div>

          <div class="status-detail">
            <% if (s.submitted) { %>
              <strong>Checked in:</strong> <%= s.checkIn %><br>
              <strong>Zone:</strong> <%= s.zone %><br>
              <strong>Targets:</strong> <%= s.targets %><br>
              <% if (s.notes && s.notes !== '—') { %><strong>Notes:</strong> <%= s.notes %><% } %>
            <% } else { %>
              Has not submitted today's checklist yet.
            <% } %>
          </div>
        </div>
      <% }) %>
    </div>

    <!-- SUMMARY ROW -->
    <%
      const checkedIn = status.filter(s => s.submitted).length;
      const total = status.length;
      const pct = total > 0 ? Math.round((checkedIn / total) * 100) : 0;
    %>
    <div class="card" style="margin-bottom:28px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <div style="font-size:13px;font-weight:700;color:var(--dark);">Team check-in today</div>
        <div style="font-size:18px;font-weight:800;color:<%= checkedIn === total ? '#059669' : '#DC2626' %>"><%= checkedIn %>/<%= total %></div>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar" style="width:<%= pct %>%"></div>
      </div>
    </div>

    <!-- HISTORY TABLE -->
    <div class="section-title">Last 7 Days — Submission History</div>
    <% if (history.length > 0) { %>
      <div class="table-scroll">
        <table class="history-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Marketer</th>
              <th>Check-in</th>
              <th>Status</th>
              <th>Zone</th>
              <th>Targets</th>
            </tr>
          </thead>
          <tbody>
            <% history.forEach(h => { %>
              <% const checkTime = formatTime(h.submitted_at); %>
              <% const late = checkTime > cutoff; %>
              <tr>
                <td><%= new Date(h.date).toLocaleDateString('en-GB', {weekday:'short', day:'numeric', month:'short'}) %></td>
                <td><strong><%= h.marketer_name %></strong></td>
                <td><%= checkTime %></td>
                <td><span class="<%= late ? 'late' : 'on-time' %>"><%= late ? '⚠️ Late' : '✅ On time' %></span></td>
                <td><%= h.zone || '—' %></td>
                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= h.targets || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="card" style="text-align:center;color:var(--gray);font-size:14px;">
        No submissions yet this week.
      </div>
    <% } %>

    <a href="/management-logout" class="logout-link">Log out of management</a>
  </div>
</body>
</html>
