<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <title>Field Dashboard — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
  <meta http-equiv="refresh" content="120">
</head>
<body class="app-bg">

  <div class="mgr-header">
    <div class="mgr-header-inner">
      <div class="app-header-badge">D</div>
      <div class="mgr-header-brand">Dashspid Ops</div>
      <span class="badge badge-orange" style="background:rgba(255,92,0,0.2);color:#ffb37a;">Manager</span>
      <div class="app-header-spacer"></div>
      <a href="/management-logout" class="btn btn-outline" style="width:auto;padding:8px 16px;font-size:13px;margin:0;color:rgba(255,255,255,0.7);border-color:rgba(255,255,255,0.2);">Log out</a>
    </div>
  </div>

  <div class="container wide">

    <div class="dash-header" style="margin-top:1.5rem;">
      <div>
        <div class="dash-title"><%= statusDate === todayDateStr ? "Today's Check-In Status" : 'Check-In Status' %></div>
        <div class="dash-date"><%= statusDateFormatted %> · Cutoff <%= cutoff %><%= statusDate === todayDateStr ? ' · Auto-refreshes every 2 minutes' : '' %></div>
      </div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;">
        <a href="/management/staff-performance" class="btn btn-outline" style="width:auto;padding:10px 18px;margin:0;">Staff Performance</a>
        <a href="/management/experiments" class="btn btn-outline" style="width:auto;padding:10px 18px;margin:0;">Experiments</a>
        <a href="/management/staff/new" class="btn btn-outline" style="width:auto;padding:10px 18px;margin:0;">+ Add Staff</a>
      </div>
    </div>

    <!-- GROWTH OS: COMPANY OVERVIEW (L1) -->
    <div class="section-title">Growth Overview</div>
    <div class="priority-tabs">
      <a href="/dashboard?overviewPeriod=today&date=<%= statusDate %>&from=<%= from %>&to=<%= to %>" class="priority-tab <%= overviewPeriod === 'today' ? 'priority-tab-active' : '' %>">Today</a>
      <a href="/dashboard?overviewPeriod=week&date=<%= statusDate %>&from=<%= from %>&to=<%= to %>" class="priority-tab <%= overviewPeriod === 'week' ? 'priority-tab-active' : '' %>">This Week</a>
      <a href="/dashboard?overviewPeriod=all&date=<%= statusDate %>&from=<%= from %>&to=<%= to %>" class="priority-tab <%= overviewPeriod === 'all' ? 'priority-tab-active' : '' %>">All-Time</a>
    </div>
    <div class="card-sub" style="margin-bottom:10px;">
      <strong><%= cohortOverview.total_leads %></strong> total leads logged in this window (warm leads + onboarded
      riders) — everything below is how many of those same <%= cohortOverview.total_leads %> have reached each
      stage so far, regardless of when.
    </div>
    <div class="status-grid">
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Total Leads</div><div class="dash-title" style="font-size:24px;"><%= cohortOverview.total_leads %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Registered</div><div class="dash-title" style="font-size:24px;"><%= cohortOverview.registered %>/<%= cohortOverview.total_leads %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Activations</div><div class="dash-title" style="font-size:24px;"><%= cohortOverview.activated %>/<%= cohortOverview.total_leads %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Links Shared</div><div class="dash-title" style="font-size:24px;"><%= cohortOverview.link_shared %>/<%= cohortOverview.total_leads %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Businesses w/ Customer Activity</div><div class="dash-title" style="font-size:24px;"><%= cohortOverview.customer_activity %>/<%= cohortOverview.total_leads %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">First Orders</div><div class="dash-title" style="font-size:24px;"><%= cohortOverview.first_order %>/<%= cohortOverview.total_leads %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Completed Orders</div><div class="dash-title" style="font-size:24px;"><%= cohortOverview.completed_order %>/<%= cohortOverview.total_leads %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Repeat Orders (Business)</div><div class="dash-title" style="font-size:24px;"><%= cohortOverview.repeat_order %>/<%= cohortOverview.total_leads %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Businesses w/ Repeat Customers</div><div class="dash-title" style="font-size:24px;"><%= cohortOverview.repeat_customer_businesses %>/<%= cohortOverview.total_leads %></div></div>
    </div>
    <% if (companyOverview.biggestLeak && companyOverview.biggestLeak.count > 0) { %>
      <div class="card" style="margin-bottom:20px;">
        <span style="font-size:13px;color:var(--gray);">Biggest funnel drop: </span>
        <strong><%= companyOverview.biggestLeak.id %> — <%= companyOverview.biggestLeak.label %></strong>
        <span style="font-size:13px;color:var(--gray);"> (<%= companyOverview.biggestLeak.count %> prospects company-wide)</span>
      </div>
    <% } %>

    <div class="section-title">Engagement — <%= overviewPeriod === 'all' ? 'All-Time' : overviewPeriod === 'today' ? "Usage Today (shares/visitors are always all-time)" : "Usage This Week (shares/visitors are always all-time)" %></div>
    <div class="status-grid">
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Link Shares</div><div class="dash-title" style="font-size:24px;"><%= companyOverview.total_link_shares || 0 %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Unique Storefront Visitors</div><div class="dash-title" style="font-size:24px;"><%= companyOverview.total_unique_visitors || 0 %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Dashboard Opens</div><div class="dash-title" style="font-size:24px;"><%= usageSummary.totalOpens %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Minutes Active in App</div><div class="dash-title" style="font-size:24px;"><%= usageSummary.totalMinutes %></div></div>
      <div class="card" style="margin-bottom:0;"><div class="card-sub" style="margin-bottom:4px;">Businesses w/ App Activity</div><div class="dash-title" style="font-size:24px;"><%= usageSummary.activeBusinesses %></div></div>
    </div>

    <div class="section-title">Onboarding Checklist Accuracy (All-Time)</div>
    <div class="card">
      <div class="card-sub" style="margin-bottom:10px;">
        Of everyone whose onboarding checklist is complete and linked to a real platform account, how many actually
        did what they ticked (pricing set, payout added, link shared) — not just self-reported.
      </div>
      <div class="detail-row">
        <span class="detail-label">Fully Verified</span>
        <span class="detail-value"><%= checklistAccuracy.fully_verified %>/<%= checklistAccuracy.total_checklists %></span>
      </div>
      <% if (checklistAccuracy.total_checklists > 0 && checklistAccuracy.fully_verified < checklistAccuracy.total_checklists) { %>
        <p style="margin-top:8px;font-size:12.5px;color:var(--red);">
          <%= checklistAccuracy.total_checklists - checklistAccuracy.fully_verified %> checklist(s) have at least
          one ticked item that isn't actually true yet — open the rider's detail page to see which one.
        </p>
      <% } %>
    </div>

    <!-- GROWTH OS: PLATFORM SYNC -->
    <div class="card" style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
      <div style="flex:1;min-width:200px;">
        <div style="font-weight:700;font-size:14px;">Platform sync</div>
        <div style="font-size:13px;color:var(--gray);">Matches onboarded riders to their DashSpid platform account and pulls in order/storefront outcomes.</div>
      </div>
      <button id="sync-platform-btn" type="button" class="btn" style="width:auto;padding:10px 20px;margin:0;">Sync now</button>
      <div id="sync-platform-result" style="width:100%;font-size:13px;color:var(--gray);"></div>
    </div>

    <!-- GOOGLE SHEET SYNC -->
    <div class="card" style="display:flex;gap:14px;align-items:center;flex-wrap:wrap;">
      <div style="flex:1;min-width:200px;">
        <div style="font-weight:700;font-size:14px;">Google Sheet sync</div>
        <div style="font-size:13px;color:var(--gray);">Leads pasted into the sheet become P6 prospects; calls logged in the sheet show up here. Runs automatically every few minutes.</div>
      </div>
      <button id="sync-sheet-btn" type="button" class="btn" style="width:auto;padding:10px 20px;margin:0;">Sync now</button>
      <div id="sync-sheet-result" style="width:100%;font-size:13px;color:var(--gray);"></div>
    </div>

    <form method="GET" action="/dashboard" class="card" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
      <div style="flex:1;min-width:140px;">
        <label for="date">View check-in status for</label>
        <input type="date" name="date" id="date" value="<%= statusDate %>" max="<%= todayDateStr %>" style="margin-bottom:0;">
      </div>
      <button type="submit" class="btn" style="width:auto;padding:12px 24px;margin:0;">View</button>
      <input type="hidden" name="from" value="<%= from %>">
      <input type="hidden" name="to" value="<%= to %>">
    </form>

    <div class="status-grid">
      <% status.forEach(s => { %>
        <% var initials = (s.name || '').trim().split(/\s+/).map(w => w[0] || '').join('').slice(0,2).toUpperCase(); %>
        <div class="status-card <%= s.submitted ? (s.isLate ? 'submitted-late' : 'submitted-on-time') : 'not-submitted' %>">
          <div class="status-head">
            <div class="avatar" style="width:40px;height:40px;font-size:14px;background:rgba(255,92,0,0.14);color:var(--orange);border:1.5px solid rgba(255,92,0,0.3);"><%= initials %></div>
            <div>
              <div class="status-name"><%= s.name %></div>
              <% if (s.submitted && !s.isLate) { %>
                <span class="badge badge-green">On time</span>
              <% } else if (s.submitted && s.isLate) { %>
                <span class="badge badge-amber">Late — <%= s.checkIn %></span>
              <% } else { %>
                <span class="badge badge-red">Not checked in</span>
              <% } %>
              <% if (s.attendanceFlagged) { %>
                <span class="badge badge-red">Flagged login</span>
              <% } %>
            </div>
          </div>

          <div class="status-detail">
            <strong>Login:</strong> <%= s.loginTime || '—' %> · <strong>Logout:</strong> <%= s.logoutTime || '—' %><br>
            <% if (s.logoutTime) { %>
              <strong>Riders onboarded:</strong> <%= s.ridersOnboardedToday != null ? s.ridersOnboardedToday : '—' %><br>
              <% if (s.daySummary) { %><strong>Day summary:</strong> <%= s.daySummary %><br><% } %>
            <% } %>
            <% if (s.submitted) { %>
              <strong>Checked in:</strong> <%= s.checkIn %><br>
              <strong>Zone:</strong> <%= s.zone %><br>
              <strong>Targets:</strong> <%= s.targets %><br>
              <% if (s.notes && s.notes !== '—') { %><strong>Notes:</strong> <%= s.notes %><% } %>
            <% } else { %>
              Has not submitted a checklist for this day.
            <% } %>
          </div>

          <% if (s.loginLat != null && s.loginLng != null) { %>
            <div class="location-block">
              <div class="location-block-label">Login location</div>
              <div class="location-block-address"><%= s.loginAddress || 'Address unavailable' %></div>
              <div class="location-block-coords">
                <%= s.loginLat %>, <%= s.loginLng %>
                <a href="https://www.google.com/maps?q=<%= s.loginLat %>,<%= s.loginLng %>" target="_blank" rel="noopener">View on map</a>
              </div>
              <% if (s.loginAccuracy != null) { %>
                <div class="location-block-coords">Accuracy: ±<%= Math.round(s.loginAccuracy) %>m<% if (s.loginAccuracy > 500) { %> (low precision — could be a weak GPS/network fix, not necessarily wrong)<% } %></div>
              <% } %>
              <% if (s.loginDevice) { %><div class="location-block-coords">Device: <%= s.loginDevice %></div><% } %>
            </div>
          <% } %>

          <% if (s.logoutLat != null && s.logoutLng != null) { %>
            <div class="location-block">
              <div class="location-block-label">Logout location</div>
              <div class="location-block-address"><%= s.logoutAddress || 'Address unavailable' %></div>
              <div class="location-block-coords">
                <%= s.logoutLat %>, <%= s.logoutLng %>
                <a href="https://www.google.com/maps?q=<%= s.logoutLat %>,<%= s.logoutLng %>" target="_blank" rel="noopener">View on map</a>
              </div>
              <% if (s.logoutAccuracy != null) { %>
                <div class="location-block-coords">Accuracy: ±<%= Math.round(s.logoutAccuracy) %>m<% if (s.logoutAccuracy > 500) { %> (low precision — could be a weak GPS/network fix, not necessarily wrong)<% } %></div>
              <% } %>
              <% if (s.logoutDevice) { %><div class="location-block-coords">Device: <%= s.logoutDevice %></div><% } %>
            </div>
          <% } %>
        </div>
      <% }) %>
    </div>

    <!-- SUMMARY ROW -->
    <%
      const checkedIn = status.filter(s => s.submitted).length;
      const total = status.length;
      const pct = total > 0 ? Math.round((checkedIn / total) * 100) : 0;
    %>
    <div class="card" style="margin-bottom:28px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px;">
        <div style="font-size:13px;font-weight:700;color:var(--dark);">Team check-in</div>
        <div style="font-size:18px;font-weight:800;color:<%= checkedIn === total ? '#059669' : '#DC2626' %>"><%= checkedIn %>/<%= total %></div>
      </div>
      <div class="progress-bar-wrap">
        <div class="progress-bar" style="width:<%= pct %>%"></div>
      </div>
    </div>

    <!-- DATE RANGE FILTER -->
    <div class="dash-header" style="margin-top:8px;">
      <div class="dash-title" style="font-size:16px;">Historical Records</div>
    </div>
    <form method="GET" action="/dashboard" class="card" style="display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap;">
      <div style="flex:1;min-width:140px;">
        <label for="from">From</label>
        <input type="date" name="from" id="from" value="<%= from %>" max="<%= to %>" style="margin-bottom:0;">
      </div>
      <div style="flex:1;min-width:140px;">
        <label for="to">To</label>
        <input type="date" name="to" id="to" value="<%= to %>" min="<%= from %>" style="margin-bottom:0;">
      </div>
      <button type="submit" class="btn" style="width:auto;padding:12px 24px;margin:0;">Filter</button>
    </form>

    <!-- HISTORY TABLE -->
    <div class="section-title">Submission History — <%= formatDateShort(from) %> to <%= formatDateShort(to) %></div>
    <% if (history.length > 0) { %>
      <div class="table-scroll">
        <table class="history-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Marketer</th>
              <th>Check-in</th>
              <th>Status</th>
              <th>Zone</th>
              <th>Targets</th>
            </tr>
          </thead>
          <tbody>
            <% history.forEach(h => { %>
              <% const checkTime = formatTime(h.submitted_at); %>
              <% const late = checkTime > cutoff; %>
              <tr>
                <td><%= h.dateFormatted %></td>
                <td><strong><%= h.marketer_name %></strong></td>
                <td><%= checkTime %></td>
                <td><span class="<%= late ? 'late' : 'on-time' %>"><%= late ? 'Late' : 'On time' %></span></td>
                <td><%= h.zone || '—' %></td>
                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= h.targets || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="card" style="text-align:center;color:var(--gray);font-size:14px;">
        No submissions in this date range.
      </div>
    <% } %>

    <!-- ATTENDANCE HISTORY -->
    <div class="section-title">Attendance History — <%= formatDateShort(from) %> to <%= formatDateShort(to) %></div>
    <% if (attendanceHistory.length > 0) { %>
      <div class="table-scroll">
        <table class="history-table">
          <thead>
            <tr>
              <th>Date</th>
              <th>Marketer</th>
              <th>Login</th>
              <th>Logout</th>
              <th>Riders</th>
              <th>Summary</th>
              <th>Status</th>
            </tr>
          </thead>
          <tbody>
            <% attendanceHistory.forEach(a => { %>
              <tr>
                <td><%= a.dateFormatted %></td>
                <td><strong><%= a.marketer_name %></strong></td>
                <td><%= a.loginFormatted %></td>
                <td><%= a.logoutFormatted %></td>
                <td><%= a.ridersOnboarded != null ? a.ridersOnboarded : '—' %></td>
                <td style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= a.summary || '—' %></td>
                <td>
                  <% if (a.flagged) { %>
                    <span class="badge badge-red">Flagged</span>
                  <% } else { %>
                    <span class="badge badge-green">Clean</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="card" style="text-align:center;color:var(--gray);font-size:14px;">
        No attendance recorded yet.
      </div>
    <% } %>

    <!-- RIDERS ONBOARDED -->
    <div class="section-title">Riders Onboarded — <%= formatDateShort(from) %> to <%= formatDateShort(to) %></div>
    <% if (riders.length > 0) { %>
      <div class="table-scroll">
        <table class="history-table">
          <thead>
            <tr>
              <th>Date Added</th>
              <th>Rider</th>
              <th>Email</th>
              <th>Phone</th>
              <th>Added By</th>
              <th>Device Used</th>
              <th>Checklist Status</th>
              <th>Attribution Code</th>
              <th>Funnel Stage</th>
              <th>Notes</th>
            </tr>
          </thead>
          <tbody>
            <% riders.forEach(r => { %>
              <tr>
                <td><%= r.dateAdded %> <%= r.timeAdded %></td>
                <td><strong><%= r.name %></strong></td>
                <td><%= r.email %></td>
                <td><%= r.phone %></td>
                <td><%= r.added_by_marketer_name %></td>
                <td>
                  <%= r.device || 'Unknown device' %>
                  <% if (r.device_flagged) { %>
                    <br><span class="badge badge-red" title="<%= r.device_flag_reason %>">Flagged</span>
                  <% } %>
                </td>
                <td>
                  <% if (r.completed) { %>
                    <span class="badge badge-green">Done — <%= r.timeCompleted %></span>
                  <% } else { %>
                    <span class="badge badge-amber">In progress</span>
                  <% } %>
                </td>
                <td style="font-family:'SF Mono',Consolas,monospace;"><%= r.staff_ops_code || '—' %></td>
                <td>
                  <% if (r.platform_business_id) { %>
                    <span class="badge badge-green"><%= r.funnel_stage %></span>
                  <% } else { %>
                    <span class="badge badge-amber"><%= r.funnel_stage || 'new' %></span>
                  <% } %>
                </td>
                <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= r.notes || '—' %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="card" style="text-align:center;color:var(--gray);font-size:14px;">
        No riders onboarded in this date range.
      </div>
    <% } %>

    <!-- FLAGGED ATTENDANCE -->
    <div class="section-title">Flagged Attendance — <%= formatDateShort(from) %> to <%= formatDateShort(to) %></div>
    <% if (flaggedEvents.length > 0) { %>
      <div class="table-scroll">
        <table class="history-table">
          <thead>
            <tr>
              <th>Date/Time</th>
              <th>Marketer</th>
              <th>Type</th>
              <th>IP</th>
              <th>Device</th>
              <th>Location</th>
              <th>Reason</th>
            </tr>
          </thead>
          <tbody>
            <% flaggedEvents.forEach(a => { %>
              <tr>
                <td><%= formatDateShort(a.timestamp.slice(0, 10)) %> <%= formatTime(a.timestamp) %></td>
                <td><strong><%= a.marketer_name %></strong></td>
                <td><%= a.type === 'login' ? 'Login' : 'Logout' %></td>
                <td><%= a.ip %></td>
                <td><%= a.device || 'Unknown device' %></td>
                <td style="min-width:200px;">
                  <div class="location-block-address"><%= a.address || 'Address unavailable' %></div>
                  <div class="location-block-coords">
                    <%= a.lat %>, <%= a.lng %>
                    <a href="https://www.google.com/maps?q=<%= a.lat %>,<%= a.lng %>" target="_blank" rel="noopener">View on map</a>
                  </div>
                  <% if (a.accuracy != null) { %>
                    <div class="location-block-coords">Accuracy: ±<%= Math.round(a.accuracy) %>m<% if (a.accuracy > 500) { %> (low precision)<% } %></div>
                  <% } %>
                </td>
                <td><%= a.flags.join('; ') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="card" style="text-align:center;color:var(--gray);font-size:14px;">
        No flagged attendance in this date range.
      </div>
    <% } %>

    <a href="/management-logout" class="logout-link">Log out of management</a>
  </div>

  <script>
    document.getElementById('sync-platform-btn').addEventListener('click', async function () {
      var btn = this;
      var result = document.getElementById('sync-platform-result');
      btn.disabled = true;
      btn.textContent = 'Syncing…';
      result.textContent = '';
      try {
        var res = await fetch('/management/sync-platform', { method: 'POST', headers: { 'X-Requested-With': 'fetch' } });
        var data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Sync failed');
        result.textContent = 'Matched ' + data.matchResult.matched + ' of ' + data.matchResult.checked + ' pending codes · ' +
          'attributed ' + data.nameMatchResult.attributed + ' of ' + data.nameMatchResult.checked + ' name-matched signups · ' +
          'checked ' + data.syncResult.checked + ' linked prospect(s) for order/storefront updates.';
      } catch (err) {
        result.textContent = 'Sync failed: ' + err.message;
      } finally {
        btn.disabled = false;
        btn.textContent = 'Sync now';
      }
    });

    document.getElementById('sync-sheet-btn').addEventListener('click', async function () {
      var btn = this;
      var result = document.getElementById('sync-sheet-result');
      btn.disabled = true;
      btn.textContent = 'Syncing…';
      result.textContent = '';
      try {
        var res = await fetch('/management/sync-sheet', { method: 'POST', headers: { 'X-Requested-With': 'fetch' } });
        if (res.redirected || (res.headers.get('content-type') || '').indexOf('json') === -1) {
          throw new Error('Your management session expired (the app restarts on every deploy) — reload this page and log in again, then retry.');
        }
        var data = await res.json();
        if (!res.ok || !data.ok) throw new Error(data.error || 'Sync failed');
        result.textContent = 'Read ' + data.rows + ' row(s) · created ' + data.created + ' lead(s) · linked ' + data.linked +
          ' to existing · updated ' + data.updated + ' · logged ' + data.callsLogged + ' call(s) · added ' + data.appended +
          ' lead(s) to the sheet · moved ' + data.moved + ' to a new stage tab' +
          (data.errors ? ' · ' + data.errors + ' row(s) need attention (see Sync Status column)' : '') +
          (data.tabProblems && data.tabProblems.length ? ' · ' + data.tabProblems.join('; ') : '') + '.';
      } catch (err) {
        result.textContent = 'Sync failed: ' + err.message;
      } finally {
        btn.disabled = false;
        btn.textContent = 'Sync now';
      }
    });
  </script>
</body>
</html>
