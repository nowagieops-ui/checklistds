<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Rider Onboarded — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=<%= assetVersion %>">
  <link rel="manifest" href="/manifest.json?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body class="app-bg">

  <div class="app-header">
    <div class="app-header-inner">
      <a href="/home" class="app-header-brand">
        <div class="app-header-badge">D</div>
        Dashspid Ops
      </a>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <div class="success-title">Rider onboarded.</div>
      <div class="success-sub"><%= rider.name %> is ready to ride.</div>

      <div class="detail-row">
        <span class="detail-label">Email</span>
        <span class="detail-value"><%= rider.email %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Phone</span>
        <span class="detail-value"><%= rider.phone %></span>
      </div>
      <% if (time) { %>
        <div class="detail-row">
          <span class="detail-label">Onboarding completed</span>
          <span class="detail-value"><%= time %></span>
        </div>
      <% } %>
      <% if (rider.notes) { %>
        <div class="detail-row">
          <span class="detail-label">Notes</span>
          <span class="detail-value"><%= rider.notes %></span>
        </div>
      <% } %>
    </div>

    <% if (rider.staff_ops_code) { %>
      <div class="card" style="margin-top:12px;text-align:center;">
        <div class="success-sub" style="margin-bottom:8px;">Attribution code</div>
        <div style="font-family:'SF Mono',Consolas,monospace;font-size:clamp(22px,7vw,28px);font-weight:700;letter-spacing:3px;color:var(--dark);word-break:break-all;">
          <%= rider.staff_ops_code %>
        </div>
        <p style="margin-top:10px;font-size:13.5px;color:var(--gray);line-height:1.5;">
          Give this code to <%= rider.name %>. When they sign up on the DashSpid platform, they must enter it
          exactly where it asks how they heard about DashSpid — this is what credits the signup to you.
        </p>
      </div>
    <% } %>

    <a href="/riders/new" class="btn" style="margin-bottom:12px;">Onboard Another Rider →</a>
    <a href="/home" class="btn btn-outline">← Back to Home</a>
  </div>

  <script src="/install-prompt.js?v=<%= assetVersion %>"></script>
</body>
</html>
