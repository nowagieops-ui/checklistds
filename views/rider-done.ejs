<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Rider Onboarded — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=<%= assetVersion %>">
  <link rel="manifest" href="/manifest.json?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body class="app-bg">

  <div class="app-header">
    <div class="app-header-inner">
      <div class="app-header-brand">
        <div class="app-header-badge">D</div>
        Dashspid Ops
      </div>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <div class="success-icon">✅</div>
      <div class="success-title">Rider onboarded.</div>
      <div class="success-sub"><%= rider.name %> is ready to ride.</div>

      <div class="detail-row">
        <span class="detail-label">Email</span>
        <span class="detail-value"><%= rider.email %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Phone</span>
        <span class="detail-value"><%= rider.phone %></span>
      </div>
      <% if (time) { %>
        <div class="detail-row">
          <span class="detail-label">Onboarding completed</span>
          <span class="detail-value"><%= time %></span>
        </div>
      <% } %>
    </div>

    <a href="/riders/new" class="btn" style="margin-bottom:12px;">Onboard Another Rider →</a>
    <a href="/home" class="auth-link" style="display:block;text-align:center;">← Back to Home</a>
  </div>

  <script src="/install-prompt.js?v=<%= assetVersion %>"></script>
</body>
</html>
