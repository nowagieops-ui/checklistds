<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#6366f1">
  <title>Dashspid Ops — Morning Checklist</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="stylesheet" href="/style.css">
  <noscript><style>.splash{display:none !important} .needs-js{display:none !important}</style></noscript>
</head>
<body>

  <div class="loader-overlay" id="loaderOverlay">
    <div>
      <div class="loader-spinner"></div>
      <div class="loader-text">Preparing your checklist... just a moment.</div>
    </div>
  </div>

  <div class="splash" id="splash">
    <div class="splash-badge">D</div>
    <div class="splash-title">Dashspid <span>Ops</span></div>
    <div class="splash-tagline">We believe we can teach everything<br><em>except commitment.</em></div>
    <div class="splash-bar-track"><div class="splash-bar-fill"></div></div>
  </div>

  <noscript>
    <div class="auth-page">
      <div class="auth-card" style="text-align:center;">
        <div class="auth-card-title">JavaScript required</div>
        <p style="color:rgba(255,255,255,0.6);font-size:13px;">Please enable JavaScript to sign in to Dashspid Ops.</p>
      </div>
    </div>
  </noscript>

  <div class="auth-page needs-js" id="authPage" style="opacity:0;transition:opacity .5s ease;">
    <div class="auth-header">
      <div class="brand-badge">D</div>
      <div class="auth-title">Dashspid Ops</div>
      <div class="auth-sub">Morning Field Checklist</div>
    </div>

    <% if (error) { %>
      <div class="auth-card" style="margin-bottom:12px;">
        <div class="error" style="margin-bottom:0;"><%= error %></div>
      </div>
    <% } %>

    <div class="auth-card" id="stepSearch">
      <div class="auth-card-title">Who are you?</div>
      <input class="auth-input" id="nameInput" placeholder="Start typing your name..." autocomplete="off">
      <div id="matchList"></div>
    </div>

    <div class="auth-card" id="stepPin" style="display:none;">
      <div class="pin-header">
        <div class="avatar" id="pinAvatar" style="width:56px;height:56px;font-size:20px;"></div>
        <div class="pin-name" id="pinName"></div>
        <div class="pin-caption">Enter your PIN</div>
      </div>
      <div class="pin-error" id="pinError" style="display:none;"></div>
      <div class="pin-dots" id="pinDots">
        <div class="pin-dot"></div><div class="pin-dot"></div><div class="pin-dot"></div><div class="pin-dot"></div>
      </div>
      <div class="keypad" id="keypad"></div>
      <button type="button" class="auth-link" id="backBtn" style="margin-top:16px;">← Back</button>
    </div>

    <a href="/management-login" class="auth-link">Management access →</a>
  </div>

  <script>
    var MARKETERS = <%- JSON.stringify(marketers || []).replace(/</g, '\\u003c') %>;
    var PALETTE = ['#6366f1', '#0891b2', '#059669', '#dc2626', '#d97706', '#7c3aed', '#db2777', '#ea580c'];

    function initials(name) {
      return (name || '').trim().split(/\s+/).map(function (w) { return w[0] || ''; }).join('').slice(0, 2).toUpperCase();
    }
    function colorFor(id) { return PALETTE[id % PALETTE.length]; }

    var nameInput = document.getElementById('nameInput');
    var matchList = document.getElementById('matchList');
    var stepSearch = document.getElementById('stepSearch');
    var stepPin = document.getElementById('stepPin');
    var pinAvatar = document.getElementById('pinAvatar');
    var pinName = document.getElementById('pinName');
    var pinDots = document.getElementById('pinDots');
    var pinError = document.getElementById('pinError');
    var keypad = document.getElementById('keypad');
    var backBtn = document.getElementById('backBtn');
    var loaderOverlay = document.getElementById('loaderOverlay');

    var selected = null;
    var buffer = '';
    var submitting = false;

    nameInput.addEventListener('input', function () {
      var q = nameInput.value.trim().toLowerCase();
      matchList.innerHTML = '';
      if (q.length < 2) return;
      var matches = MARKETERS.filter(function (m) {
        return m.name.toLowerCase().indexOf(q) > -1;
      }).slice(0, 5);
      if (matches.length === 0) {
        var empty = document.createElement('div');
        empty.className = 'match-empty';
        empty.textContent = 'No match found';
        matchList.appendChild(empty);
        return;
      }
      matches.forEach(function (m) {
        var row = document.createElement('div');
        row.className = 'match-row';
        row.innerHTML =
          '<div class="avatar" style="width:44px;height:44px;font-size:15px;background:' + colorFor(m.id) + '22;color:' + colorFor(m.id) + ';border:1.5px solid ' + colorFor(m.id) + '55;">' + initials(m.name) + '</div>' +
          '<div style="flex:1;"><div class="match-name">' + m.name + '</div><div class="match-tap">Tap to continue</div></div>' +
          '<span class="match-check">✓</span>';
        row.addEventListener('click', function () { selectMarketer(m); });
        matchList.appendChild(row);
      });
    });

    function selectMarketer(m) {
      selected = m;
      buffer = '';
      pinError.style.display = 'none';
      pinAvatar.style.background = colorFor(m.id) + '22';
      pinAvatar.style.color = colorFor(m.id);
      pinAvatar.style.border = '1.5px solid ' + colorFor(m.id) + '55';
      pinAvatar.textContent = initials(m.name);
      pinName.textContent = m.name;
      renderDots();
      buildKeypad();
      stepSearch.style.display = 'none';
      stepPin.style.display = 'block';
    }

    function buildKeypad() {
      keypad.innerHTML = '';
      var keys = ['1', '2', '3', '4', '5', '6', '7', '8', '9', '', '0', '⌫'];
      keys.forEach(function (k) {
        var btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'keypad-btn' + (k === '' ? ' blank' : '');
        btn.textContent = k;
        if (k === '') { btn.disabled = true; }
        else {
          btn.addEventListener('click', function () {
            if (submitting) return;
            if (k === '⌫') { buffer = buffer.slice(0, -1); }
            else if (buffer.length < 4) { buffer += k; }
            renderDots();
            if (buffer.length === 4) submitPin();
          });
        }
        keypad.appendChild(btn);
      });
    }

    function renderDots() {
      var dots = pinDots.querySelectorAll('.pin-dot');
      dots.forEach(function (d, i) {
        d.classList.toggle('filled', i < buffer.length);
      });
    }

    function shakeAndReset(message) {
      pinError.textContent = message;
      pinError.style.display = 'block';
      pinDots.classList.add('shake');
      setTimeout(function () {
        pinDots.classList.remove('shake');
        buffer = '';
        renderDots();
      }, 400);
    }

    function submitPin() {
      submitting = true;
      fetch('/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'fetch' },
        body: 'marketer_id=' + encodeURIComponent(selected.id) + '&pin=' + encodeURIComponent(buffer)
      })
        .then(function (r) { return r.json().then(function (data) { return { status: r.status, data: data }; }); })
        .then(function (res) {
          submitting = false;
          if (res.data.ok) {
            loaderOverlay.classList.add('active');
            window.location.href = res.data.redirect;
          } else {
            shakeAndReset(res.data.error || 'Incorrect PIN. Please try again.');
          }
        })
        .catch(function () {
          submitting = false;
          shakeAndReset('Connection error. Please try again.');
        });
    }

    backBtn.addEventListener('click', function () {
      stepPin.style.display = 'none';
      stepSearch.style.display = 'block';
      selected = null;
      buffer = '';
      pinError.style.display = 'none';
      nameInput.value = '';
      matchList.innerHTML = '';
      nameInput.focus();
    });

    // ── Splash boot sequence ──
    var splash = document.getElementById('splash');
    var authPage = document.getElementById('authPage');
    setTimeout(function () { splash.classList.add('step1'); }, 100);
    setTimeout(function () { splash.classList.add('step2'); }, 700);
    setTimeout(function () {
      splash.classList.add('hide');
      authPage.style.opacity = '1';
    }, 1600);
    setTimeout(function () { splash.style.display = 'none'; }, 2300);
  </script>
</body>
</html>
