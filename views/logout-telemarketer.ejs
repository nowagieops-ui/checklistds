<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Checkout — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=<%= assetVersion %>">
  <link rel="manifest" href="/manifest.json?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body class="app-bg">

  <div class="app-header">
    <div class="app-header-inner">
      <a href="/home" class="app-header-brand">
        <div class="app-header-badge">D</div>
        Dashspid Ops
      </a>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <div class="card-title">End of Day</div>
      <div class="card-sub">Hi <%= name %>. Quick check before you go.</div>

      <div class="detail-row">
        <span class="detail-label">Call target</span>
        <span class="detail-value"><%= target %></span>
      </div>
      <div class="detail-row">
        <span class="detail-label">Calls logged today</span>
        <span class="detail-value"><%= actualCalls %></span>
      </div>

      <% if (actualCalls >= target) { %>
        <div class="note-box">
          <div class="note-box-body">🎯 Target hit — nice work.</div>
        </div>
      <% } else { %>
        <div class="note-box">
          <div class="note-box-body"><%= target - actualCalls %> short of target today.</div>
        </div>
        <label for="reason">What got in the way?</label>
        <textarea id="reason" placeholder="What got in the way today?"></textarea>
      <% } %>
    </div>

    <div class="card">
      <div class="error" id="logoutError" style="display:none;margin-bottom:12px;"></div>

      <button type="button" class="btn" id="confirmLogoutBtn">Confirm Checkout →</button>
      <a href="/checklist" class="auth-link" style="display:block;text-align:center;margin-top:14px;">← Back, I'm not leaving yet</a>
    </div>
  </div>

  <div class="loader-overlay" id="loaderOverlay">
    <div>
      <div class="loader-spinner"></div>
      <div class="loader-text">Logging you out...</div>
    </div>
  </div>

  <script>
    var reasonBox = document.getElementById('reason');
    var btn = document.getElementById('confirmLogoutBtn');
    var errBox = document.getElementById('logoutError');
    var loaderOverlay = document.getElementById('loaderOverlay');
    var submitting = false;

    function showError(msg) {
      errBox.textContent = msg;
      errBox.style.display = 'block';
    }

    function resetButton() {
      submitting = false;
      btn.disabled = false;
      btn.textContent = 'Confirm Checkout →';
    }

    // No location capture here — telemarketers work from a desk, not in
    // the field, so unlike the field checkout this just posts directly.
    btn.addEventListener('click', function () {
      if (submitting) return;
      submitting = true;
      btn.disabled = true;
      btn.textContent = 'Submitting...';
      errBox.style.display = 'none';

      var body = 'reason=' + encodeURIComponent(reasonBox ? reasonBox.value : '');

      fetch('/logout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'fetch' },
        body: body
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.ok) {
            loaderOverlay.classList.add('active');
            window.location.href = data.redirect;
          } else {
            resetButton();
            showError(data.error || 'Something went wrong. Please try again.');
          }
        })
        .catch(function () {
          resetButton();
          showError('Connection error. Please try again.');
        });
    });
  </script>
  <script src="/install-prompt.js?v=<%= assetVersion %>"></script>
</body>
</html>
