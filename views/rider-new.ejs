<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Onboard New Rider — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=<%= assetVersion %>">
  <link rel="manifest" href="/manifest.json?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body class="app-bg">

  <div class="app-header">
    <div class="app-header-inner">
      <div class="app-header-brand">
        <div class="app-header-badge">D</div>
        Dashspid Ops
      </div>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <div class="card-title">Onboard New Rider</div>
      <div class="card-sub">Hi <%= name %>. Enter the rider's details to start onboarding.</div>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/riders" id="riderForm">
        <label for="name">Rider's full name <span style="color:var(--red)">*</span></label>
        <input type="text" name="name" id="name" placeholder="e.g. Musa Abdullahi" required>

        <label for="email">Email address <span style="color:var(--red)">*</span></label>
        <input type="email" name="email" id="email" placeholder="e.g. musa@example.com" required>

        <label for="phone">Phone number <span style="color:var(--red)">*</span></label>
        <input type="tel" name="phone" id="phone" placeholder="e.g. 08012345678" required>

        <button type="submit" class="btn" id="submitBtn">Continue to Checklist →</button>
      </form>
    </div>

    <a href="/home" class="auth-link" style="display:block;text-align:center;">← Back to Home</a>
  </div>

  <div class="loader-overlay" id="loaderOverlay">
    <div>
      <div class="loader-spinner"></div>
      <div class="loader-text">Setting up rider profile...</div>
    </div>
  </div>

  <script>
    document.getElementById('riderForm').addEventListener('submit', function() {
      document.getElementById('submitBtn').disabled = true;
      document.getElementById('submitBtn').textContent = 'Please wait...';
      document.getElementById('loaderOverlay').classList.add('active');
    });
  </script>
  <script src="/install-prompt.js?v=<%= assetVersion %>"></script>
</body>
</html>
