<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Rider Onboarding — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=<%= assetVersion %>">
  <link rel="manifest" href="/manifest.json?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body class="app-bg">

  <div class="app-header">
    <div class="app-header-inner">
      <div class="app-header-brand">
        <div class="app-header-badge">D</div>
        Dashspid Ops
      </div>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <div class="card-title">Rider/Vendor Onboarding Checklist</div>
      <div class="card-sub">
        Rider: <strong><%= rider.name %></strong><br>
        <%= rider.email %> · <%= rider.phone %>
      </div>

      <form method="POST" action="/riders/<%= rider.id %>/checklist" id="riderChecklistForm">
        <div class="checklist-section">
          <div class="checklist-section-title">The Pitch</div>

          <label class="check-item">
            <input type="checkbox" name="item_intro" value="1" required>
            <span class="check-item-text">
              Introduced yourself and explained who Dashspid is
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_pitch_problem" value="1" required>
            <span class="check-item-text">
              Explained why they should stop being "slaves" to Uber/Bolt/other apps — commissions eating their money, no ownership of their own customers — and how Dashspid fixes that (their own store, direct orders, they keep more)
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_shield" value="1" required>
            <span class="check-item-text">
              Told them about the Dashspid Shield plan and what it protects them from
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_referral" value="1" required>
            <span class="check-item-text">
              Told them about the Dashspid referral program and how they can earn from referring others
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_overview" value="1" required>
            <span class="check-item-text">
              Asked for their overview — what they currently do, biggest pain point, how many orders/deliveries a day
              <span class="check-required"> *required</span>
            </span>
          </label>
        </div>

        <div class="checklist-section">
          <div class="checklist-section-title">Sign Up</div>

          <label class="check-item">
            <input type="checkbox" name="item_signup" value="1" required>
            <span class="check-item-text">
              Signed up on Dashspid
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_payout" value="1" required>
            <span class="check-item-text">
              Added payout details (bank account)
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_whatsapp" value="1" required>
            <span class="check-item-text">
              Connected WhatsApp
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_availability" value="1" required>
            <span class="check-item-text">
              Set availability / business hours
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_pricing" value="1" required>
            <span class="check-item-text">
              Set pricing
              <span class="check-required"> *required</span>
            </span>
          </label>
        </div>

        <div class="checklist-section">
          <div class="checklist-section-title">Walkthrough</div>

          <label class="check-item">
            <input type="checkbox" name="item_features" value="1" required>
            <span class="check-item-text">
              Explained the main features (dashboard, orders, notifications)
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_test_order" value="1" required>
            <span class="check-item-text">
              Done a test order together, start to finish
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_marketing_kit" value="1" required>
            <span class="check-item-text">
              Shown them the Marketing Kit (business card + logo)
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_shared_link" value="1" required>
            <span class="check-item-text">
              Confirmed they've shared their business card/link to at least one real customer
              <span class="check-required"> *required</span>
            </span>
          </label>
        </div>

        <div class="checklist-section">
          <div class="checklist-section-title">Confirm</div>

          <label class="check-item">
            <input type="checkbox" name="item_app_installed" value="1" required>
            <span class="check-item-text">
              Installed the app (Android) or added to home screen (iPhone)
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_notifications" value="1" required>
            <span class="check-item-text">
              Confirmed they're getting order notifications properly
              <span class="check-required"> *required</span>
            </span>
          </label>

          <label class="check-item">
            <input type="checkbox" name="item_contact" value="1" required>
            <span class="check-item-text">
              They know who to contact if something breaks
              <span class="check-required"> *required</span>
            </span>
          </label>
        </div>

        <div class="checklist-section">
          <div class="checklist-section-title">Notes</div>

          <label for="notes">Anything else to flag about this rider/vendor?</label>
          <textarea name="notes" id="notes" placeholder="Optional — objections raised, follow-up needed, etc."></textarea>
        </div>

        <button type="submit" class="btn" id="submitBtn">Complete Onboarding →</button>
      </form>
    </div>

    <a href="/home" class="auth-link" style="display:block;text-align:center;">← Back to Home</a>
  </div>

  <div class="loader-overlay" id="loaderOverlay">
    <div>
      <div class="loader-spinner"></div>
      <div class="loader-text">Saving onboarding checklist...</div>
    </div>
  </div>

  <script>
    document.getElementById('riderChecklistForm').addEventListener('submit', function() {
      document.getElementById('submitBtn').disabled = true;
      document.getElementById('submitBtn').textContent = 'Saving...';
      document.getElementById('loaderOverlay').classList.add('active');
    });
  </script>
  <script src="/install-prompt.js?v=<%= assetVersion %>"></script>
</body>
</html>
