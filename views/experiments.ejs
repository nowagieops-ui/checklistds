<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <title>Experiments — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body class="app-bg">

  <div class="mgr-header">
    <div class="mgr-header-inner">
      <div class="app-header-badge">D</div>
      <div class="mgr-header-brand">Dashspid Ops</div>
      <span class="badge badge-orange" style="background:rgba(255,92,0,0.2);color:#ffb37a;">Manager</span>
      <div class="app-header-spacer"></div>
      <a href="/management-logout" class="btn btn-outline" style="width:auto;padding:8px 16px;font-size:13px;margin:0;color:rgba(255,255,255,0.7);border-color:rgba(255,255,255,0.2);">Log out</a>
    </div>
  </div>

  <div class="container">
    <div class="dash-header" style="margin-top:1.5rem;">
      <div>
        <div class="dash-title">Experiments</div>
        <div class="dash-date">An experiment succeeds because the metric moved — not because people say they like it.</div>
      </div>
    </div>

    <% if (error) { %>
      <div class="error"><%= error %></div>
    <% } %>

    <div class="card">
      <div class="card-title" style="font-size:15px;margin-bottom:12px;">New Experiment</div>
      <form method="POST" action="/management/experiments">
        <label for="problem">Problem</label>
        <textarea name="problem" id="problem" rows="2" required></textarea>

        <label for="hypothesis">Hypothesis</label>
        <textarea name="hypothesis" id="hypothesis" rows="2" required></textarea>

        <label for="change_description">Change</label>
        <textarea name="change_description" id="change_description" rows="2" required></textarea>

        <label for="start_date">Start date</label>
        <input type="date" name="start_date" id="start_date" required>

        <label for="target_metric">Target metric</label>
        <input type="text" name="target_metric" id="target_metric" placeholder="e.g. P2->P3 conversion rate" required>

        <button type="submit" class="btn">Log Experiment →</button>
      </form>
    </div>

    <div class="section-title">Running / Past Experiments</div>
    <% if (experiments.length === 0) { %>
      <div class="card" style="text-align:center;color:var(--gray);font-size:14px;">No experiments logged yet.</div>
    <% } else { %>
      <% experiments.forEach(function (e) { %>
        <div class="card">
          <div class="detail-row"><span class="detail-label">Problem</span><span class="detail-value"><%= e.problem %></span></div>
          <div class="detail-row"><span class="detail-label">Hypothesis</span><span class="detail-value"><%= e.hypothesis %></span></div>
          <div class="detail-row"><span class="detail-label">Change</span><span class="detail-value"><%= e.change_description %></span></div>
          <div class="detail-row"><span class="detail-label">Target metric</span><span class="detail-value"><%= e.target_metric %></span></div>
          <div class="detail-row"><span class="detail-label">Start</span><span class="detail-value"><%= e.startFormatted %></span></div>
          <% if (e.endFormatted) { %>
            <div class="detail-row"><span class="detail-label">End</span><span class="detail-value"><%= e.endFormatted %></span></div>
          <% } %>
          <% if (e.decision) { %>
            <div class="detail-row">
              <span class="detail-label">Decision</span>
              <span class="badge <%= e.decision === 'keep' ? 'badge-green' : e.decision === 'kill' ? 'badge-red' : 'badge-amber' %>"><%= e.decision %></span>
            </div>
          <% } %>
          <% if (e.result) { %>
            <div class="detail-row"><span class="detail-label">Result</span><span class="detail-value"><%= e.result %></span></div>
          <% } %>

          <details style="margin-top:10px;">
            <summary style="cursor:pointer;font-size:13px;color:var(--orange-dark);font-weight:600;">Record result / decision</summary>
            <form method="POST" action="/management/experiments/<%= e.id %>/result" style="margin-top:10px;">
              <label for="result-<%= e.id %>">Result</label>
              <textarea name="result" id="result-<%= e.id %>" rows="2"><%= e.result || '' %></textarea>

              <label for="decision-<%= e.id %>">Decision</label>
              <select name="decision" id="decision-<%= e.id %>">
                <option value="">— Not decided —</option>
                <option value="keep" <%= e.decision === 'keep' ? 'selected' : '' %>>Keep</option>
                <option value="modify" <%= e.decision === 'modify' ? 'selected' : '' %>>Modify</option>
                <option value="kill" <%= e.decision === 'kill' ? 'selected' : '' %>>Kill</option>
              </select>

              <label for="end_date-<%= e.id %>">End date</label>
              <input type="date" name="end_date" id="end_date-<%= e.id %>" value="<%= e.end_date || '' %>">

              <button type="submit" class="btn btn-outline">Save →</button>
            </form>
          </details>
        </div>
      <% }) %>
    <% } %>

    <a href="/dashboard" class="logout-link">← Back to Dashboard</a>
  </div>
</body>
</html>
