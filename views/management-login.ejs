<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <title>Management — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
  <noscript><style>.needs-js{display:none !important}</style></noscript>
</head>
<body>

  <div class="loader-overlay" id="loaderOverlay">
    <div>
      <div class="loader-spinner"></div>
      <div class="loader-text">Verifying your access... standby.</div>
    </div>
  </div>

  <noscript>
    <div class="auth-page">
      <div class="auth-card" style="text-align:center;">
        <div class="auth-card-title">JavaScript required</div>
        <p style="color:rgba(255,255,255,0.6);font-size:13px;">Please enable JavaScript to access the management dashboard.</p>
      </div>
    </div>
  </noscript>

  <div class="auth-page needs-js">
    <div class="auth-header">
      <div class="brand-badge">D</div>
      <div class="auth-title">Dashspid Ops</div>
      <div class="auth-sub">Management Access</div>
    </div>

    <div class="auth-card">
      <div class="pin-header" style="margin-bottom:1rem;">
        <div class="pin-name" style="margin-top:0;">Management Dashboard</div>
        <div class="pin-caption">Enter your management PIN</div>
      </div>

      <div class="pin-error" id="pinError" style="display:none;"></div>

      <form id="mgmtForm">
        <input
          class="auth-input"
          type="password"
          name="pin"
          id="pinInput"
          placeholder="Enter PIN"
          autocomplete="off"
          required
        >
        <button type="submit" class="btn" id="submitBtn" style="margin-top:14px;">Access Dashboard →</button>
      </form>
    </div>

    <a href="/" class="auth-link">← Back to field login</a>
  </div>

  <script>
    var pinInput = document.getElementById('pinInput');
    var pinError = document.getElementById('pinError');
    var mgmtForm = document.getElementById('mgmtForm');
    var submitBtn = document.getElementById('submitBtn');
    var loaderOverlay = document.getElementById('loaderOverlay');
    var submitting = false;

    function showError(message) {
      pinError.textContent = message;
      pinError.style.display = 'block';
      pinInput.value = '';
      pinInput.focus();
    }

    mgmtForm.addEventListener('submit', function (e) {
      e.preventDefault();
      if (submitting) return;
      submitting = true;
      submitBtn.disabled = true;
      pinError.style.display = 'none';

      fetch('/management-login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'fetch' },
        body: 'pin=' + encodeURIComponent(pinInput.value)
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          submitting = false;
          submitBtn.disabled = false;
          if (data.ok) {
            loaderOverlay.classList.add('active');
            window.location.href = data.redirect;
          } else {
            showError(data.error || 'Incorrect PIN.');
          }
        })
        .catch(function () {
          submitting = false;
          submitBtn.disabled = false;
          showError('Connection error. Please try again.');
        });
    });
  </script>
</body>
</html>
