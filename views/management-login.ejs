<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Management — Dashspid</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="loader-overlay" id="loaderOverlay">
    <div>
      <div class="loader-spinner"></div>
      <div class="loader-text">Verifying your access... standby.</div>
    </div>
  </div>

  <div class="container">
    <div class="logo">
      <div class="logo-text">DASHSPID</div>
      <div class="logo-sub">Management Access</div>
      <div class="logo-highlight">Secure management sign-in with the same polished experience.</div>
    </div>

    <div class="card">
      <div class="card-title">Management Dashboard</div>
      <div class="card-sub">Enter your management PIN to view today's check-in status.</div>

      <% if (error) { %>
        <div class="error"><%= error %></div>
      <% } %>

      <form method="POST" action="/management-login" id="managementLoginForm">
        <label for="pin">Management PIN</label>
        <input
          type="password"
          name="pin"
          id="pin"
          placeholder="Enter PIN"
          required
          autocomplete="off"
          inputmode="numeric"
        >
        <button type="submit" class="btn">Access Dashboard →</button>
      </form>
    </div>

    <a href="/" class="logout-link">← Back to field login</a>
  </div>

  <script>
    document.getElementById('managementLoginForm').addEventListener('submit', function() {
      document.getElementById('loaderOverlay').classList.add('active');
    });
  </script>
</body>
</html>
