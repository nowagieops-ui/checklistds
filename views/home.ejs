<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Home — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=<%= assetVersion %>">
  <link rel="manifest" href="/manifest.json?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body class="app-bg">

  <div class="app-header">
    <div class="app-header-inner">
      <a href="/home" class="app-header-brand">
        <div class="app-header-badge">D</div>
        Dashspid Ops
      </a>
      <div class="app-header-spacer"></div>
      <span class="badge badge-orange"><%= date %></span>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <div class="card-title">Hi <%= name %></div>
      <div class="card-sub">What do you need to do?</div>
    </div>

    <% if (canCheckin) { %>
      <a href="/checklist" class="home-tile">
        <div class="home-tile-body">
          <div class="home-tile-title">Daily Checklist</div>
          <div class="home-tile-sub">Not done yet — tap to start</div>
        </div>
        <div class="home-tile-arrow">→</div>
      </a>
    <% } else if (canCheckout) { %>
      <a href="/logout" class="home-tile">
        <div class="home-tile-body">
          <div class="home-tile-title">Daily Checkout</div>
          <div class="home-tile-sub">End of day — tap to clock out</div>
        </div>
        <div class="home-tile-arrow">→</div>
      </a>
    <% } else if (missedCheckin) { %>
      <div class="card">
        <div class="card-sub">You didn't check in before the 12pm cutoff today — no checklist available.</div>
      </div>
    <% } %>

    <a href="<%= queueHref %>" class="home-tile">
      <div class="home-tile-body">
        <div class="home-tile-title"><%= queueHeading %></div>
        <div class="home-tile-sub"><%= openProspects %> lead<%= openProspects === 1 ? '' : 's' %> need<%= openProspects === 1 ? 's' : '' %> action</div>
      </div>
      <div class="home-tile-arrow">→</div>
    </a>

    <a href="/my-performance" class="home-tile">
      <div class="home-tile-body">
        <div class="home-tile-title">My Performance</div>
        <div class="home-tile-sub">See who you've called that has registered, and your funnel this period</div>
      </div>
      <div class="home-tile-arrow">→</div>
    </a>

    <% if (role === 'telemarketer') { %>
      <a href="/call-reviews" class="home-tile">
        <div class="home-tile-body">
          <div class="home-tile-title">Call Reviews</div>
          <div class="home-tile-sub">Upload today's calls — AI grades each one and shows what to improve</div>
        </div>
        <div class="home-tile-arrow">→</div>
      </a>
    <% } %>

    <% if (weeklyTraining && weeklyTraining.prelaunch) { %>
      <div class="card">
        <div class="card-sub">NowagieOps training starts <%= weeklyTraining.unlockDateFormatted %>. You can still work the call queue and leads in the meantime.</div>
      </div>
    <% } else if (weeklyTraining && weeklyTraining.done) { %>
      <a href="<%= weeklyTraining.href %>" class="home-tile">
        <div class="home-tile-body">
          <div class="home-tile-title">Training Programme Complete</div>
          <div class="home-tile-sub">All <%= weeklyTraining.totalWeeks %> weeks finished — view your certificate</div>
        </div>
        <div class="home-tile-arrow">→</div>
      </a>
    <% } else if (weeklyTraining && weeklyTraining.available) { %>
      <a href="<%= weeklyTraining.href %>" class="home-tile">
        <div class="home-tile-body">
          <div class="home-tile-title">Week <%= weeklyTraining.weekNumber %> Training: <%= weeklyTraining.title %></div>
          <div class="home-tile-sub">Available now — tap to start this week's lessons</div>
        </div>
        <div class="home-tile-arrow">→</div>
      </a>
    <% } else if (weeklyTraining) { %>
      <div class="card">
        <div class="card-sub">Week <%= weeklyTraining.weekNumber %> training (<%= weeklyTraining.title %>) unlocks <%= weeklyTraining.unlockDateFormatted %>.</div>
      </div>
    <% } %>

    <% if (role !== 'telemarketer') { %>
      <a href="/riders/new" class="home-tile">
        <div class="home-tile-body">
          <div class="home-tile-title">Onboard New Rider</div>
          <div class="home-tile-sub">Add a rider's details and walk through onboarding</div>
        </div>
        <div class="home-tile-arrow">→</div>
      </a>
    <% } %>

    <a href="<%= addLeadHref %>" class="home-tile">
      <div class="home-tile-body">
        <div class="home-tile-title">Add New Lead</div>
        <div class="home-tile-sub">Log a new warm prospect to call — no checklist</div>
      </div>
      <div class="home-tile-arrow">→</div>
    </a>

    <a href="/prospects" class="home-tile">
      <div class="home-tile-body">
        <div class="home-tile-title">All My Prospects</div>
        <div class="home-tile-sub">Everyone you've worked, converted or not</div>
      </div>
      <div class="home-tile-arrow">→</div>
    </a>

    <a href="/sign-out" class="logout-link">Not you? Log out</a>

    <div class="card">
      <div class="card-title" style="font-size:15px;margin-bottom:2px;">Your Attendance</div>
      <div class="card-sub" style="margin-bottom:14px;">Since you started, up to the last 14 days</div>

      <div class="attendance-calendar">
        <% attendanceCalendar.forEach(function (d) { %>
          <div class="attendance-day attendance-day-<%= d.status %>" title="<%= d.date %>"><%= d.label %></div>
        <% }) %>
      </div>

      <div class="attendance-legend">
        <span class="legend-item"><span class="legend-dot legend-dot-complete"></span> On time</span>
        <span class="legend-item"><span class="legend-dot legend-dot-late"></span> Late</span>
        <span class="legend-item"><span class="legend-dot legend-dot-missed"></span> Missed</span>
        <span class="legend-item"><span class="legend-dot legend-dot-pending"></span> Today</span>
        <span class="legend-item"><span class="legend-dot legend-dot-weekend"></span> Weekend</span>
      </div>
    </div>
  </div>

  <script src="/install-prompt.js?v=<%= assetVersion %>"></script>
</body>
</html>
