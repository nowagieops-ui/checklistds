<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#FF5C00">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <title>Home — Dashspid Ops</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=<%= assetVersion %>">
  <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png?v=<%= assetVersion %>">
  <link rel="manifest" href="/manifest.json?v=<%= assetVersion %>">
  <link rel="stylesheet" href="/style.css?v=<%= assetVersion %>">
</head>
<body class="app-bg">

  <div class="app-header">
    <div class="app-header-inner">
      <div class="app-header-brand">
        <div class="app-header-badge">D</div>
        Dashspid Ops
      </div>
      <div class="app-header-spacer"></div>
      <span class="badge badge-orange"><%= date %></span>
    </div>
  </div>

  <div class="container">
    <div class="card">
      <div class="card-title">Hi <%= name %></div>
      <div class="card-sub">What do you need to do?</div>
    </div>

    <% if (submittedToday) { %>
      <a href="/logout" class="home-tile">
        <div class="home-tile-body">
          <div class="home-tile-title">Daily Logout</div>
          <div class="home-tile-sub">Checklist done for today — tap to clock out</div>
        </div>
        <div class="home-tile-arrow">→</div>
      </a>
    <% } else { %>
      <a href="/checklist" class="home-tile">
        <div class="home-tile-body">
          <div class="home-tile-title">Daily Checklist</div>
          <div class="home-tile-sub">Not done yet — tap to start</div>
        </div>
        <div class="home-tile-arrow">→</div>
      </a>
    <% } %>

    <a href="/riders/new" class="home-tile">
      <div class="home-tile-body">
        <div class="home-tile-title">Onboard New Rider</div>
        <div class="home-tile-sub">Add a rider's details and walk through onboarding</div>
      </div>
      <div class="home-tile-arrow">→</div>
    </a>

    <% if (!submittedToday) { %>
      <a href="/logout" class="logout-link">Not you? Log out</a>
    <% } %>

    <div class="card">
      <div class="card-title" style="font-size:15px;margin-bottom:2px;">Your Attendance</div>
      <div class="card-sub" style="margin-bottom:14px;">Last 14 days</div>

      <div class="attendance-calendar">
        <% attendanceCalendar.forEach(function (d) { %>
          <div class="attendance-day attendance-day-<%= d.status %>" title="<%= d.date %>"><%= d.label %></div>
        <% }) %>
      </div>

      <div class="attendance-legend">
        <span class="legend-item"><span class="legend-dot legend-dot-complete"></span> Checked in &amp; out</span>
        <span class="legend-item"><span class="legend-dot legend-dot-missed"></span> Missed</span>
        <span class="legend-item"><span class="legend-dot legend-dot-pending"></span> Today</span>
      </div>
    </div>
  </div>

  <script src="/install-prompt.js?v=<%= assetVersion %>"></script>
</body>
</html>
