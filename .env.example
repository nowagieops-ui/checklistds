# MySQL — from Hostinger hPanel > Databases
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# App
SESSION_SECRET=
MANAGEMENT_PIN=
CHECKIN_CUTOFF=08:45
PORT=3000

# WhatsApp notifications via CallMeBot
CALLMEBOT_PHONE=
CALLMEBOT_API_KEY=

# Gemini API (Google AI Studio) — powers the telemarketer training academy's
# AI roleplay feedback (/training). Optional: without it, roleplay practice
# still works but falls back to a generic canned feedback message instead of
# live AI review.
GEMINI_API_KEY=

# Google Sheet lead sync (services/sheetsSync.js) — optional; sync stays off
# until all three of the first three are set. See README "Google Sheet sync".
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Owner for pasted rows whose "Assigned To" cell is blank (a marketers.id)
SHEETS_DEFAULT_STAFF_ID=

# DashSpid platform (Supabase) — for connecting Staff Ops to orders/storefronts
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
